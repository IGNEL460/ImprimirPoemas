<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFloatingView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="8dp">

    <!-- Badge con el precio detectado de Uber -->
    <LinearLayout
        android:id="@+id/layoutPriceBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_floating_badge"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDetectedPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ 0.00"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Burbuja principal flotante -->
    <FrameLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_floating_bubble"
        android:elevation="8dp">

        <!-- Icono normal (Point Terminal) -->
        <ImageView
            android:id="@+id/ivBubbleIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_point_terminal" />

        <!-- Spinner de carga cuando se envía el cobro -->
        <ProgressBar
            android:id="@+id/pbBubbleLoading"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
